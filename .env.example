# Variables del docker compose local. Copiar a .env:  cp .env.example .env
# .env está en .gitignore y no se sube nunca.

# ─── Postgres local ───────────────────────────────────────────────────────
POSTGRES_USER=planta
POSTGRES_PASSWORD=planta
POSTGRES_DB=maceta
# Cambiar si el 5432 ya está ocupado por otro Postgres en la máquina.
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────
# El MISMO valor que va en firmware/include/secrets.h y en Railway.
# Para generar uno: openssl rand -hex 32
DEVICE_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio-minimo-32-caracteres
PHOTO_READ_TOKEN=cambia-esto-por-otro-token-largo-y-distinto
MAX_PHOTO_BYTES=2097152
# En local las fotos se guardan en el volumen `fotos_local`. En Railway se
# usan las credenciales inyectadas por el Bucket y esta ruta no se usa.
PHOTO_STORAGE_DIR=/data/fotos
BACKEND_PORT=8000
CORS_ORIGENES=http://localhost:5173

# ─── Frontend ─────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
