# Variables del docker compose local. Copiar a .env:  cp .env.example .env
# .env está en .gitignore y no se sube nunca.

# ─── Postgres local ───────────────────────────────────────────────────────
POSTGRES_USER=planta
POSTGRES_PASSWORD=planta
POSTGRES_DB=maceta
# Cambiar si el 5432 ya está ocupado por otro Postgres en la máquina.
POSTGRES_PORT=5432

# ─── Backend ──────────────────────────────────────────────────────────────
# El MISMO valor que va en firmware/include/secrets.h y en Railway.
# Para generar uno: openssl rand -hex 32
DEVICE_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio-minimo-32-caracteres
PHOTO_READ_TOKEN=cambia-esto-por-otro-token-largo-y-distinto
MAX_PHOTO_BYTES=2097152
# En local las fotos se guardan en el volumen `fotos_local`. En Railway se
# usan las credenciales inyectadas por el Bucket y esta ruta no se usa.
PHOTO_STORAGE_DIR=/data/fotos
BACKEND_PORT=8000
CORS_ORIGENES=http://localhost:5173
# Análisis de fotos con IA (pestaña «Analizar foto»). Se usa Gemini si está su
# clave (tiene plan gratuito) y si no Claude; IA_PROVEEDOR=gemini|anthropic
# fuerza uno. Sin ninguna, el modo IA responde 503 y la visión clásica anda igual.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
IA_PROVEEDOR=
# Clave de la sección «Calibrar» del front (sube y lee fotos de calibración).
# Sin ella esa sección responde 503.
CALIBRACION_TOKEN=cambia-esto-por-una-clave-para-calibrar

# ─── Bot de Telegram «Ruperto» (Tarea 3, docs/ENTREGA3.md §5.6) ───────────
# Se levanta con `docker compose --profile bot up`. Usa GEMINI_API_KEY (arriba).
# Token de @BotFather. Un token = un solo proceso en polling: no correr el bot
# local con el mismo token que el de Railway.
TELEGRAM_BOT_TOKEN=
# Modelos de Gemini (vacío = default del código): chat y embeddings. El de
# embeddings de las consultas lo fija el índice (meta.json); este lo usa
# rag/construir_indice.py al generarlo.
GEMINI_MODELO=
GEMINI_MODELO_EMBED=
# Modelo del filtro de tema; vacío = el mismo que GEMINI_MODELO (D216).
GEMINI_MODELO_GUARDRAIL=
# Dispositivo del que habla Ruperto.
BOT_DISPOSITIVO=maceta-01

# ─── Frontend ─────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
